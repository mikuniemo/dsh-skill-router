{
  "name": "dsh-skill-luyou",
  "version": "1.0.0",
  "description": "Shrink the DeepSeek Harness skill catalog from O(all skills) to ~600 tokens by turning it into a router + on-demand category indexes. Cross-platform, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-skill-luyou": "bin/dsh-skill-luyou.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "scan": "node bin/dsh-skill-luyou.mjs scan",
    "plan": "node bin/dsh-skill-luyou.mjs plan"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-skills",
    "skill-router",
    "context-optimization",
    "token-budget",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikuniemo/dsh-skill-luyou.git"
  },
  "bugs": {
    "url": "https://github.com/mikuniemo/dsh-skill-luyou/issues"
  },
  "homepage": "https://github.com/mikuniemo/dsh-skill-luyou#readme"
}
