{
  "name": "dsh-skill-router",
  "version": "1.1.0",
  "description": "把 DeepSeek Harness 的技能目录从 O(全部技能) 降到 ~600 token：一个常驻路由器 + 按需分类索引。跨平台、零依赖。",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-skill-router": "bin/dsh-skill-router.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "scan": "node bin/dsh-skill-router.mjs scan",
    "route": "node bin/dsh-skill-router.mjs route",
    "plan": "node bin/dsh-skill-router.mjs plan"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-skills",
    "skill-router",
    "context-optimization",
    "token-budget",
    "query-routing",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikuniemo/dsh-skill-router.git"
  },
  "bugs": {
    "url": "https://github.com/mikuniemo/dsh-skill-router/issues"
  },
  "homepage": "https://github.com/mikuniemo/dsh-skill-router#readme"
}
